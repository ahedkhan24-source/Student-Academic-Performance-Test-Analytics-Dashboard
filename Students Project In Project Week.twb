      <aliases enabled='yes' />
      <column caption='Study_Hours_Clean' datatype='string' name='[Calculation_1216379654189056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [WklyStudyHours]=&quot;&lt; 5&quot; THEN &quot;Less than 5 hours&quot;&#13;&#10;ELSEIF [WklyStudyHours]=&quot;&gt; 10&quot; THEN &quot;Greater than 10 hours&quot;&#13;&#10;ELSEIF [WklyStudyHours]= &quot;05-Oct&quot; THEN &quot;Between 5 to 10 Hours&quot;&#13;&#10;ELSE &quot;Not Recorded&quot;&#13;&#10;END' />
