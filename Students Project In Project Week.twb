      <column caption='Parent_Educ_Clean' datatype='string' name='[Calculation_1216379658137602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([ParentEduc],&quot;Not Specified&quot;)' />
      </column>
      <column caption='Total_Score' datatype='integer' name='[Calculation_1216379659501571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[WritingScore]+[ReadingScore]+[MathScore]' />
      </column>
      <column caption='Average_Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1216379659853828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1216379659501571]/3' />
      </column>
      <column caption='Letter_Grade' datatype='string' name='[Calculation_1216379661189125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1216379659853828] &gt;= 90 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_1216379659853828] &gt;= 80 THEN &quot;B&quot;&#13;&#10;ELSEIF [Calculation_1216379659853828] &gt;= 70 THEN &quot;C&quot;&#13;&#10;ELSEIF [Calculation_1216379659853828] &gt;= 60 THEN &quot;D&quot;&#13;&#10;ELSE &quot;F&quot;&#13;&#10;END' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_1216379662155782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1216379661189125]=&quot;F&quot; THEN &quot;Fail&quot;&#13;&#10;ELSE &quot;Pass&quot;&#13;&#10;END' />
      </column>
      <column caption='Test_Prep_Clean' datatype='string' name='[Calculation_1216379663167496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TestPrep]=&quot;completed&quot; THEN &quot;Completed Prep&quot;&#13;&#10;ELSE &quot;Prep Not Completed&quot;&#13;&#10;END' />
      </column>
      <column caption='Class _Average' datatype='real' name='[Calculation_1216379665666057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :AVG([Calculation_1216379659853828]) }' />
      </column>
      <column caption='Group Wise Average' datatype='real' name='[Calculation_1216379666903050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_1216379656916993] :AVG([Calculation_1216379659853828]) }' />
      </column>
      <column caption='Delta' datatype='real' name='[Calculation_1216379669487627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1216379659853828]-68.12' />
      </column>
      <column caption='is_passing' datatype='string' name='[Calculation_1479437877678080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1216379659853828]&gt;=60 THEN &quot;Pass&quot;&#13;&#10;ELSE &quot;At Risk/Fail&quot;&#13;&#10;END' />
      </column>
      <column caption='Chosen ethnic grpoup' datatype='real' name='[Calculation_1479437916491781]' role='measure' type='quantitative'>
